# Secrets. Keep out of git (.gitignore covers .env).
#
# IMPORTANT: put comments on their own line, never after a value. Nothing
# that reads this file strips a trailing comment reliably -- systemd would
# read "TOKEN=abc  # note" as the value "abc  # note" -- so a value runs to
# the end of its line.

# Page access token for Republic of Barbers (Page 106828815133188).
# Must be a PAGE token, derived from a long-lived user token so it does
# not expire. See README.md step 4.
ROB_PAGE_TOKEN=

# Page access token for Raising Thinkers (Page 1059125853953466).
RAISING_THINKERS_PAGE_TOKEN=

# Long-lived USER token, used only for reading ad accounts.
#
# A Page token cannot read /act_<id>/ads -- ads_read is granted to the user,
# not the Page -- so ad comments need this as well as the Page tokens above.
# One token covers every ad account your user can see, so both businesses
# share it.
#
# Unlike the Page tokens, this one EXPIRES after about 60 days. When ad
# comments start reporting as "not checked", this is why: repeat the
# exchange step in README.md and paste the new value here. For a token that
# does not expire, create a System User in Business settings and issue its
# token instead.
FB_ADS_USER_TOKEN=

# Where to post the digest. Only used with --notify, and only when there is
# something new or something broke -- a quiet run says nothing.
#
# Telegram: the chat_id must be on the end. Get the bot token from
# @BotFather, then find the chat id by sending your bot a message and
# opening https://api.telegram.org/bot<TOKEN>/getUpdates
#   https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<CHAT_ID>
#
# Slack:   https://hooks.slack.com/services/T000/B000/xxxx
# Discord: https://discord.com/api/webhooks/000/xxxx
FBMONITOR_WEBHOOK_URL=
