# One Page access token per business. These are secrets — keep this file
# out of git (.gitignore already covers .env).
#
# Each token must be a Page token for that business's Page, because ad
# comments live on the Page post behind the ad.
#
# Generate at developers.facebook.com/tools/explorer, then exchange for a
# long-lived token — see README.md.

ROB_PAGE_TOKEN=                 # Republic of Barbers  (106828815133188)
RAISING_THINKERS_PAGE_TOKEN=    # Raising Thinkers     (1059125853953466)
FITFABLE_PAGE_TOKEN=            # Fitfable             (117731341219971)
